{
  "name": "codex-token-caches",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node companion/build.mjs",
    "desktop:start": "node launcher/worker.mjs launch .local-runtime/desktop",
    "package:windows": "pnpm build && node launcher/build-windows.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "node tests/desktop/signed-overlay.mjs",
    "test:package": "node tests/desktop/signed-package.mjs"
  },
  "dependencies": {
    "eventsource-parser": "^4.1.2",
    "lowdb": "^7.0.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
